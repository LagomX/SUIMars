{
  "expo": {
    "name": "Mars DDP",
    "slug": "mars-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "marsapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router"
    ]
  }
}
