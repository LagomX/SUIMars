SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Optional; defaults to contracts/mars/Published.toml.
# SUI_PACKAGE_ID=0x...
# PACKAGE_ID=0x...

# Required for pricing/listing/purchase flow.
ADMIN_CAP_ID=0x...
USDC_TREASURY_CAP_ID=0x...
TESTUSDC_TYPE=0x...::usdc::USDC

# Optional. If unset, the active Sui CLI wallet signs admin/buyer transactions.
BUYER_PRIVATE_KEY=
BUYER_ADDRESS=0x...

# Optional smoke-run limits.
# MAX_REGISTRATIONS=1
