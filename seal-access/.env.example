# Mars Seal Access — real testnet settings.

# Optional. If unset, reads contracts/mars/Published.toml.
SEAL_PACKAGE_ID=

# Sui testnet fullnode used by Seal SessionKey and seal_approve dry-runs.
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Official Seal testnet decentralized committee server.
SEAL_KEY_SERVER_OBJECT_ID=0xb012378c9f3799fb5b1a7083da74a4069e3c3f1c93de0b27212a5799ce1e1e98
SEAL_AGGREGATOR_URL=https://seal-aggregator-testnet.mystenlabs.com
SEAL_THRESHOLD=1
SEAL_VERIFY_KEY_SERVERS=false

# Optional. If unset, the active Sui CLI wallet signs the buyer SessionKey.
# NEVER use a mainnet wallet here.
BUYER_PRIVATE_KEY=

# Walrus testnet aggregator used to fetch encrypted blobs by blob_id.
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
