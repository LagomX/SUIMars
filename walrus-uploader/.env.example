SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# Optional; defaults to the active Sui CLI wallet.
# SUI_PRIVATE_KEY=suiprivkey...

# Optional; defaults to contracts/mars/Published.toml [published.testnet].
# SUI_PACKAGE_ID=0x...
# SEAL_PACKAGE_ID=0x...

# Walrus HTTP Publisher — no CLI required.
# Defaults to the public testnet publisher if unset.
# WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_EPOCHS=2

# Seal (testnet defaults)
SEAL_KEY_SERVER_OBJECT_ID=0xb012378c9f3799fb5b1a7083da74a4069e3c3f1c93de0b27212a5799ce1e1e98
SEAL_AGGREGATOR_URL=https://seal-aggregator-testnet.mystenlabs.com
SEAL_THRESHOLD=1
SEAL_VERIFY_KEY_SERVERS=false

# Input paths (relative to project root)
USERS_PATH=simulator/users/all_users.json
RAW_ASSETS_DIR=simulator/output/raw_assets

# Optional: limit shard uploads for smoke tests.
# MAX_UPLOADS=1
