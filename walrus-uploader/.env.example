MOCK_WALRUS=false
WALRUS_CLI_PATH=walrus
WALRUS_CONTEXT=testnet
WALRUS_EPOCHS=2

# Defaults are resolved from the project root.
USERS_PATH=simulator/users/all_users.json
RAW_ASSETS_DIR=simulator/output/raw_assets

# Useful for smoke tests before uploading every personal dataset.
# MAX_UPLOADS=1

# Optional if your Walrus CLI uses a non-default config file.
# WALRUS_CONFIG_PATH=/Users/you/.config/walrus/client_config.yaml

# Sui + Seal registration runs in the same process as encryption so raw AES
# keys are never persisted to disk.
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# SUI_PRIVATE_KEY=suiprivkey...
# SEAL_PACKAGE_ID=0x... # optional; defaults to contracts/mars/Published.toml
SEAL_KEY_SERVER_OBJECT_ID=0xb012378c9f3799fb5b1a7083da74a4069e3c3f1c93de0b27212a5799ce1e1e98
SEAL_AGGREGATOR_URL=https://seal-aggregator-testnet.mystenlabs.com
SEAL_THRESHOLD=1
SEAL_VERIFY_KEY_SERVERS=false
