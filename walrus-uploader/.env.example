SUI_NETWORK=testnet
PACKAGE_ID=
SUI_MOCK=true
WALRUS_MOCK=true
WALRUS_EPOCHS=5
WALRUS_CONTEXT=testnet
WALRUS_CLI_PATH=walrus
# WALRUS_CONFIG=

# Required for real Sui mode.
# SUI_PRIVATE_KEY=
# ADMIN_CAP_ID=
# USDC_TREASURY_CAP_ID=
# USDC_DECIMALS=6

# Contributor addresses are written into on-chain DataAsset contributors.
# If you want one wallet to run the whole testnet sample, set all three to
# the same address as SUI_PRIVATE_KEY.
# CONTRIBUTOR_RIDER_ADDRESS=
# CONTRIBUTOR_MERCHANT_ADDRESS=
# CONTRIBUTOR_CONSUMER_ADDRESS=

# Optional chain runner controls.
# ASSET_ID=package_01_rider_mobility
# CHAIN_MAX_ASSETS=1
# USDC_MINT_RECIPIENT=
# USDC_MINT_AMOUNT=100
# RIDER_MOBILITY_PRICE_USDC=3
# MERCHANT_OPERATIONS_PRICE_USDC=2
# CONSUMER_BEHAVIOR_PRICE_USDC=1
# RIDER_MOBILITY_QUALITY_SCORE=90
# MERCHANT_OPERATIONS_QUALITY_SCORE=86
# CONSUMER_BEHAVIOR_QUALITY_SCORE=82
